<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>de.cubeisland</groupId>
    <artifactId>auctionhousaqua</artifactId>
    <version>1.21.8-1.4.6-inventoryviewfix154</version>
    <name>AuctionHousAqua</name>
    <packaging>jar</packaging>
    <description>Offline-ready auction house plugin for Minecraft 1.21.8</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>
        <local.libs.dir>C:/1.21.8</local.libs.dir>

        <paper.api.jar>${local.libs.dir}/paper-api-1.21.8-R0.1-SNAPSHOT.jar</paper.api.jar>
        <vault.api.jar>${local.libs.dir}/Vault.jar</vault.api.jar>

        <adventure.api.jar>${local.libs.dir}/adventure-api-4.24.0.jar</adventure.api.jar>
        <adventure.key.jar>${local.libs.dir}/adventure-key-4.24.0.jar</adventure.key.jar>
        <adventure.minimessage.jar>${local.libs.dir}/adventure-text-minimessage-4.24.0.jar</adventure.minimessage.jar>
        <adventure.gson.jar>${local.libs.dir}/adventure-text-serializer-gson-4.24.0.jar</adventure.gson.jar>
        <adventure.legacy.jar>${local.libs.dir}/adventure-text-serializer-legacy-4.24.0.jar</adventure.legacy.jar>
        <adventure.plain.jar>${local.libs.dir}/adventure-text-serializer-plain-4.24.0.jar</adventure.plain.jar>
        <adventure.logger.slf4j.jar>${local.libs.dir}/adventure-text-logger-slf4j-4.24.0.jar</adventure.logger.slf4j.jar>
        <examination.api.jar>${local.libs.dir}/examination-api-1.3.0.jar</examination.api.jar>

        <guava.jar>${local.libs.dir}/guava-33.3.1-jre.jar</guava.jar>
        <gson.jar>${local.libs.dir}/gson-2.11.0.jar</gson.jar>
        <snakeyaml.jar>${local.libs.dir}/snakeyaml-2.2.jar</snakeyaml.jar>
        <joml.jar>${local.libs.dir}/joml-1.10.8.jar</joml.jar>
        <fastutil.jar>${local.libs.dir}/fastutil-8.5.15.jar</fastutil.jar>
        <log4j.api.jar>${local.libs.dir}/log4j-api-2.24.1.jar</log4j.api.jar>
        <slf4j.api.jar>${local.libs.dir}/slf4j-api-2.0.16.jar</slf4j.api.jar>
        <brigadier.jar>${local.libs.dir}/brigadier-1.3.10.jar</brigadier.jar>
        <bungeecord.chat.jar>${local.libs.dir}/bungeecord-chat-1.21-R0.2-deprecated+build.21.jar</bungeecord.chat.jar>
        <jspecify.jar>${local.libs.dir}/jspecify-1.0.0.jar</jspecify.jar>
        <checker.qual.jar>${local.libs.dir}/checker-qual-3.49.2.jar</checker.qual.jar>
        <mysql.connector.jar>${local.libs.dir}/mysql-connector-j-9.2.0.jar</mysql.connector.jar>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>1.21.8-R0.1-SNAPSHOT</version>
            <scope>system</scope>
            <systemPath>${paper.api.jar}</systemPath>
        </dependency>
        <dependency>
            <groupId>com.github.MilkBowl</groupId>
            <artifactId>Vault</artifactId>
            <version>1.7.1</version>
            <scope>system</scope>
            <systemPath>${vault.api.jar}</systemPath>
        </dependency>

        <dependency>
            <groupId>net.kyori</groupId>
            <artifactId>adventure-api</artifactId>
            <version>4.24.0</version>
            <scope>system</scope>
            <systemPath>${adventure.api.jar}</systemPath>
        </dependency>
        <dependency>
            <groupId>net.kyori</groupId>
            <artifactId>adventure-key</artifactId>
            <version>4.24.0</version>
            <scope>system</scope>
            <systemPath>${adventure.key.jar}</systemPath>
        </dependency>
        <dependency>
            <groupId>net.kyori</groupId>
            <artifactId>adventure-text-minimessage</artifactId>
            <version>4.24.0</version>
            <scope>system</scope>
            <systemPath>${adventure.minimessage.jar}</systemPath>
        </dependency>
        <dependency>
            <groupId>net.kyori</groupId>
            <artifactId>adventure-text-serializer-gson</artifactId>
            <version>4.24.0</version>
            <scope>system</scope>
            <systemPath>${adventure.gson.jar}</systemPath>
        </dependency>
        <dependency>
            <groupId>net.kyori</groupId>
            <artifactId>adventure-text-serializer-legacy</artifactId>
            <version>4.24.0</version>
            <scope>system</scope>
            <systemPath>${adventure.legacy.jar}</systemPath>
        </dependency>
        <dependency>
            <groupId>net.kyori</groupId>
            <artifactId>adventure-text-serializer-plain</artifactId>
            <version>4.24.0</version>
            <scope>system</scope>
            <systemPath>${adventure.plain.jar}</systemPath>
        </dependency>
        <dependency>
            <groupId>net.kyori</groupId>
            <artifactId>adventure-text-logger-slf4j</artifactId>
            <version>4.24.0</version>
            <scope>system</scope>
            <systemPath>${adventure.logger.slf4j.jar}</systemPath>
        </dependency>
        <dependency>
            <groupId>net.kyori</groupId>
            <artifactId>examination-api</artifactId>
            <version>1.3.0</version>
            <scope>system</scope>
            <systemPath>${examination.api.jar}</systemPath>
        </dependency>

        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <version>33.3.1-jre</version>
            <scope>system</scope>
            <systemPath>${guava.jar}</systemPath>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.11.0</version>
            <scope>system</scope>
            <systemPath>${gson.jar}</systemPath>
        </dependency>
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
            <version>2.2</version>
            <scope>system</scope>
            <systemPath>${snakeyaml.jar}</systemPath>
        </dependency>
        <dependency>
            <groupId>org.joml</groupId>
            <artifactId>joml</artifactId>
            <version>1.10.8</version>
            <scope>system</scope>
            <systemPath>${joml.jar}</systemPath>
        </dependency>
        <dependency>
            <groupId>it.unimi.dsi</groupId>
            <artifactId>fastutil</artifactId>
            <version>8.5.15</version>
            <scope>system</scope>
            <systemPath>${fastutil.jar}</systemPath>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
            <version>2.24.1</version>
            <scope>system</scope>
            <systemPath>${log4j.api.jar}</systemPath>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.16</version>
            <scope>system</scope>
            <systemPath>${slf4j.api.jar}</systemPath>
        </dependency>
        <dependency>
            <groupId>com.mojang</groupId>
            <artifactId>brigadier</artifactId>
            <version>1.3.10</version>
            <scope>system</scope>
            <systemPath>${brigadier.jar}</systemPath>
        </dependency>
        <dependency>
            <groupId>net.md-5</groupId>
            <artifactId>bungeecord-chat</artifactId>
            <version>1.21-R0.2-deprecated+build.21</version>
            <scope>system</scope>
            <systemPath>${bungeecord.chat.jar}</systemPath>
        </dependency>
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
            <version>1.0.0</version>
            <scope>system</scope>
            <systemPath>${jspecify.jar}</systemPath>
        </dependency>
        <dependency>
            <groupId>org.checkerframework</groupId>
            <artifactId>checker-qual</artifactId>
            <version>3.49.2</version>
            <scope>system</scope>
            <systemPath>${checker.qual.jar}</systemPath>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>9.2.0</version>
            <scope>system</scope>
            <systemPath>${mysql.connector.jar}</systemPath>
        </dependency>

    </dependencies>

    <build>
        <finalName>AuctionHousAqua</finalName>
        <resources>
            <resource>
                <targetPath>.</targetPath>
                <directory>${basedir}/src/main/resources/</directory>
                <filtering>true</filtering>
                <includes>
                    <include>config.yml</include>
                    <include>plugin.yml</include>
                    <include>menus.yml</include>
                </includes>
            </resource>
            <resource>
                <targetPath>./language</targetPath>
                <directory>${basedir}/src/main/resources/language/</directory>
                <filtering>true</filtering>
                <includes>
                    <include>*</include>
                </includes>
            </resource>
            <resource>
                <targetPath>.</targetPath>
                <directory>${basedir}/</directory>
                <filtering>false</filtering>
                <includes>
                    <include>README.md</include>
                    <include>OFFLINE-BUILD.md</include>
                </includes>
            </resource>
        </resources>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                    <showDeprecation>true</showDeprecation>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
